# Получите на https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Названия группы и темы, где вы пишете команды и получаете личные напоминания.
# Названия должны быть точными и уникальными среди ваших чатов и тем.
CONTROL_GROUP=repeat until
CONTROL_TOPIC=reminders

# Необязательная пауза между несколькими отправками подряд, секунд.
# SEND_DELAY=0
